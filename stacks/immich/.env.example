# This is documentation, not a file to copy to .env.
#
# These are the keys Infisical must hold under /immich for this stack to
# deploy. scripts/deploy.sh injects them as environment variables; compose
# interpolates them. No .env file should ever exist in this directory.
#
# Check what Infisical currently has:
#   infisical secrets --env=prod --path=/immich

# --- required, no default -------------------------------------------------
# Alphanumeric ONLY. Immich's docs restrict this to A-Za-z0-9; anything else
# risks breaking either compose interpolation or the Postgres connection URL
# Immich builds internally. `tr -d '/+='` is not enough - it leaves base64's
# '=' padding in the value. Generate it like this:
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32
#
# Postgres reads this only when it INITIALISES the volume. Changing it later
# does not change the database password; it just makes the server unable to
# log in. Store it in your password manager the moment you generate it.
DB_PASSWORD=

# Leave this as `postgres`. scripts/immich-onedrive-sync.sh hardcodes
# POSTGRES_USER defaulting to `postgres` for its pg_dumpall - change one
# without the other and the backup silently produces an empty file.
DB_USERNAME=postgres

# --- optional, sensible defaults in compose.yml ---------------------------
# Pin a version rather than tracking `release`, so an unattended pull can't
# carry you across a breaking schema migration. v3.0.3 as of 2026-07-28.
IMMICH_VERSION=v3.0.3
DB_DATABASE_NAME=immich
TZ=America/Chicago

# Set to false immediately after you register the admin account. Disables the
# /auth/admin-sign-up endpoint, so the next person to load the site can't claim
# admin. Low stakes behind a closed router; high stakes the day 443 opens.
IMMICH_ALLOW_SETUP=true

# Where photos live. A real path on the NVMe.
# Immich creates library/ upload/ profile/ thumbs/ encoded-video/ backups/ here.
# This one is a bind mount rather than a named volume because the OneDrive
# mirror script needs to read it directly.
UPLOAD_LOCATION=/srv/immich/data

# Service names on the stack's private network. Only change these if you
# rename the services in compose.yml.
DB_HOSTNAME=database
REDIS_HOSTNAME=redis
