# This is documentation, not a file to copy to .env.
#
# These are the keys Infisical must hold under /caddy for this stack to
# deploy. scripts/deploy.sh injects them as environment variables; compose
# and the Caddyfile read them from there. No .env file belongs here.
#
# Check what Infisical currently has:
#   infisical secrets --env=prod --path=/caddy

# Cloudflare API token, scoped to Zone > DNS > Edit on one zone only.
# Create at https://dash.cloudflare.com/profile/api-tokens
# Caddy uses it solely to answer the DNS-01 challenge: it writes a
# short-lived _acme-challenge TXT record and deletes it again.
#
# New tokens are issued in Cloudflare's prefixed format (cfut_ / cfat_).
# That needs a caddy-cloudflare image built after 2026-03-23 - see the note
# on CADDY_VERSION below.
CF_API_TOKEN=

# Your zone. Drives the wildcard cert and every hostname in the Caddyfile.
DOMAIN=brent-miles.com

# Contact address Let's Encrypt uses for expiry warnings.
ACME_EMAIL=brent@brent-miles.com

# Optional - pinned in compose.yml if unset.
#
# Do not drop below 2.11. The 2.10 images bundle a caddy-dns/cloudflare build
# that predates caddy-dns/cloudflare#123 (merged 2026-03-23) and rejects
# Cloudflare's current cfut_/cfat_ token format outright:
#   provision dns.providers.cloudflare: API token '...' appears invalid
# The token is fine; the module's local format check is what fails.
CADDY_VERSION=2.11
