# Routing table for the whole house. This file is the source of truth for
# which hostname reaches which container - nothing else, nowhere else.
#
# It is split into two zones, and the split is the most important thing here:
#
#   PUBLIC    photos.<domain>, and nothing else. Answers to the open internet
#             once 443 is forwarded at the router.
#   LAN-ONLY  the *.<domain> block. Every request is checked against the house
#             subnets first and dropped if it came from anywhere else.
#
# A new app goes in the LAN-ONLY block unless exposing it was a deliberate
# decision written down in docs/decisions.md. There is no middle setting, and
# "I'll move it later" is how the cameras end up on the internet.
#
# Reload without dropping a connection:
#
#   docker exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# THAT IS ONLY ENOUGH IF YOU EDITED THIS FILE IN PLACE. After a `git pull`,
# reload silently re-reads the OLD content and reports success. This file is
# bind-mounted as a single file, which Docker binds by inode; git replaces
# files by rename rather than rewriting them, so the container keeps pointing
# at the inode it started with. Verify, then recreate if it lies to you:
#
#   docker exec caddy grep -c status /etc/caddy/Caddyfile  # 0 after a pull?
#   ./scripts/deploy.sh caddy -- --force-recreate
#
# See docs/decisions.md#single-file-bind-mounts-need-a-recreate-not-a-reload.
#
# LAN apps need no DNS record and no certificate - the wildcard covers both.
# A public app needs its own A record and a DDNS entry; see
# docs/public-access.md.

{
	email {env.ACME_EMAIL}

	# Uncomment while testing routing so you don't burn Let's Encrypt rate
	# limits. Certs will be untrusted; comment it out again once it works.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# One wildcard cert covers every subdomain, public and private alike. Issued
# over DNS-01, which is why it works for LAN-only names the public internet can
# never reach - and why forwarding 443 requires no certificate change at all.
(cf_tls) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
}

# =============================================================================
# PUBLIC
# =============================================================================

# Immich. The only hostname in this file that answers to the open internet.
#
# An exact hostname beats the wildcard below no matter which order they appear
# in - Caddy sorts site blocks by specificity, not by position in the file. So
# requests for photos.<domain> land here and never reach the wildcard, which is
# why the LAN guard down there doesn't lock out the internet.
photos.{env.DOMAIN} {
	import cf_tls

	# Its own log file, kept apart from LAN traffic. CrowdSec will parse this
	# one and only this one. Mixing internet requests together with someone on
	# the couch loading Frigate makes every scenario noisier and every alert
	# less meaningful. Deeper history than the LAN log for the same reason -
	# you will want to look back after an incident, not before one.
	log {
		output file /var/log/caddy/photos-access.log {
			roll_size 10MiB
			roll_keep 20
		}
	}

	# No request body limit is set: Caddy has none by default, which is what
	# iPhone video uploads need. Do not add `request_body max_size` here.
	reverse_proxy immich_server:2283 {
		# Caddy sets X-Forwarded-For, -Proto and -Host by itself, but not
		# X-Real-IP, which Immich's reverse proxy docs ask for.
		header_up X-Real-IP {remote_host}

		# Overwrite, not append. Caddy's default is to append the connecting
		# address to whatever X-Forwarded-For already arrived - and once this
		# is public, forged ones will arrive. Replacing the header outright
		# means Immich sees exactly one address and it is the one that
		# actually opened the connection.
		#
		# This is correct only while Caddy is the true edge. If Cloudflare's
		# proxy ever goes in front (orange cloud), revisit immediately: Caddy
		# would then be throwing away the real client IP that Cloudflare put
		# in the header and replacing it with Cloudflare's own.
		header_up X-Forwarded-For {remote_host}
	}
}

# =============================================================================
# LAN-ONLY
# =============================================================================

*.{env.DOMAIN} {
	import cf_tls

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}

	# The guard, and the reason this file is split in two.
	#
	# Written as the first `handle` rather than a bare `abort` on purpose:
	# `handle` blocks are mutually exclusive and evaluated in the order they
	# appear here, so this is guaranteed to run before any route below it. A
	# top-level `abort @notlocal` would instead be positioned by Caddy's
	# directive-ordering rules, which is a subtle thing to get wrong in a
	# block whose entire job is to not be bypassed.
	#
	# Non-LAN requests get a closed connection, not a 403 - a 403 confirms the
	# hostname exists and is worth coming back to.
	#
	# Tighten 10.0.0.0/8 to 10.0.0.0/24 once you've confirmed the Orbi hands
	# out nothing outside it (guest network, satellite backhaul).
	#
	# 172.16.0.0/12 is deliberately absent. That is Docker's own range, and
	# including it would let any container on the proxy network reach these
	# hostnames. A request from a container is not a request from the LAN.
	@notlocal not remote_ip 10.0.0.0/8 192.168.0.0/16 127.0.0.1/32
	handle @notlocal {
		abort
	}

	# --- secrets.<domain> - Infisical --------------------------------------
	@infisical host secrets.{env.DOMAIN}
	handle @infisical {
		reverse_proxy infisical_backend:8080
	}

	# --- cockpit.<domain> - Cockpit (host OS, not a container) --------------
	# The only upstream in this file that is not a container. Cockpit is a
	# systemd service on forge itself, so container-name resolution does not
	# apply - `host.docker.internal` is mapped to the proxy network's gateway
	# by the extra_hosts entry in compose.yml. Changing that entry needs a
	# real deploy; `caddy reload` will not pick it up.
	#
	# Spoken to over HTTPS with verification off: cockpit-ws serves its own
	# self-signed cert on 9090, and there is no way to give it a trusted one
	# for a name it is never addressed by. The hop is host-local. The cert the
	# browser sees is the wildcard this file already issues.
	#
	# Cockpit rejects WebSocket connections whose Origin it doesn't recognise,
	# so /etc/cockpit/cockpit.conf on the host must list this hostname. That
	# file is host state and is not in this repo - see docs/cockpit.md.
	@cockpit host cockpit.{env.DOMAIN}
	handle @cockpit {
		reverse_proxy https://host.docker.internal:9090 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	# --- security.<domain> - Frigate ---------------------------------------
	# 8971 is Frigate's *authenticated* UI. Port 5000 on the same container is
	# an unauthenticated admin port that exists for proxies which handle auth
	# themselves; this one does not, so 8971 is the only correct upstream.
	# Getting that wrong publishes the cameras to anyone on the LAN with no
	# password at all.
	#
	# This hostname must never leave the LAN-only block. An NVR is the
	# worst-case-if-breached service in the house - see
	# docs/decisions.md#frigate-is-lan-only-and-that-is-not-a-for-now.
	#
	# Frigate sets its session cookie against the host it was reached by, so it
	# needs the original Host header rather than the container name. Caddy
	# passes Host through unchanged by default, which is why nothing is set
	# here - do not "fix" this by adding header_up Host.
	@frigate host security.{env.DOMAIN}
	handle @frigate {
		reverse_proxy frigate:8971 {
			# Live view uses WebSockets and MSE. Caddy upgrades these on its
			# own; what it does not do by default is wait long enough. A live
			# stream is one long-lived response, and the default flush
			# behaviour makes it stutter on iPhones in particular.
			flush_interval -1
		}
	}

	# --- home.<domain> - Home Assistant -------------------------------------
	# The companion iPhone app points here. It talks the same HTTP/WebSocket
	# API as the browser, so there is nothing app-specific to configure.
	#
	# HA rejects proxied requests unless it has been told this proxy is
	# trusted. That lives in stacks/homeassistant/configuration.yaml under
	# http.trusted_proxies, and a mismatch presents as "400: Bad Request" at
	# login rather than as a proxy error here.
	@homeassistant host home.{env.DOMAIN}
	handle @homeassistant {
		reverse_proxy homeassistant:8123 {
			flush_interval -1
		}
	}

	# --- status.<domain> - Beszel -------------------------------------------
	# The monitoring hub. 8090 serves the UI and the REST API on one listener
	# and has no LAN guard of its own, so this block is the only thing keeping
	# it off the internet once 443 is forwarded. It stays here permanently: a
	# dashboard of what runs on this box, how full its disk is, and which
	# containers exist is a map for anyone who finds it.
	#
	# The agent is NOT reachable through Caddy and never should be. The hub
	# talks to it over a unix socket on a shared bind mount - there is no
	# hostname to give it. See docs/beszel.md.
	@beszel host status.{env.DOMAIN}
	handle @beszel {
		reverse_proxy beszel:8090 {
			# Live stats arrive over a long-lived server-sent event stream.
			# Caddy buffers those by default, which presents as a dashboard
			# that loads correctly once and then never moves - the same
			# symptom as the Frigate and Home Assistant blocks above.
			flush_interval -1
		}
	}

	# --- lab.<domain> - Homelable -------------------------------------------
	# The network map. Upstream is the frontend's nginx, not the backend:
	# nginx serves the SPA and proxies /api to homelable-backend itself, on
	# that stack's private network. The backend is not on `proxy` and has no
	# hostname here on purpose.
	#
	# This stays in the LAN-only block permanently, for a stronger reason than
	# Beszel above it. Beszel's dashboard tells you what this box runs;
	# Homelable is a drawn diagram of every host in the house, its open ports
	# and its service versions - the document an intruder would otherwise have
	# to spend a week building. See
	# docs/decisions.md#homelable-is-lan-only-and-that-is-not-a-for-now.
	@homelable host lab.{env.DOMAIN}
	handle @homelable {
		reverse_proxy homelable:80 {
			# Live node status arrives over a WebSocket at
			# /api/v1/status/ws/. Caddy upgrades it on its own but buffers
			# by default, which presents as a map that draws correctly once
			# and then never changes colour - the same symptom the Frigate,
			# Home Assistant and Beszel blocks have.
			flush_interval -1
		}
	}

	# --- deploy.<domain> - Komodo -------------------------------------------
	# The deploy UI. This is the most dangerous hostname in the file and it
	# stays in the LAN-only block permanently. Beszel above exposes a map of
	# what runs on this box; Frigate exposes the cameras; this exposes the
	# controls. Komodo's periphery agent drives the docker socket, so a session
	# here is root on forge - see the socket comment in
	# stacks/beszel/compose.yml for what that means literally.
	#
	# There is deliberately no webhook exception carved out of the @notlocal
	# guard above. GitHub cannot reach this hostname, which is why deploys are
	# a button rather than a git push - see docs/komodo.md#deploying-on-demand.
	#
	# Core also publishes 9120 on 127.0.0.1 only, for the periphery agent on
	# the host to dial. That is a loopback publish, not a LAN one, and it is
	# not the path this block uses.
	@komodo host deploy.{env.DOMAIN}
	handle @komodo {
		reverse_proxy komodo:9120 {
			# Deploy logs, container logs and the server terminal all arrive
			# over long-lived streams. Same buffering symptom as the four
			# blocks above - the page loads once and then never moves.
			flush_interval -1
		}
	}

	# --- spaghetti.<domain> - the Satisfactory save, on the Interactive Map --
	# The only hostname in this file that exists to be read by a page served
	# from somebody else's domain.
	#
	# satisfactory-calculator.com's Interactive Map loads a save handed to it as
	# ?url=... and it does that fetch IN THE BROWSER. That is why the thing
	# upstream asks for is a CORS header rather than a public address, and it is
	# the entire reason this block gets to sit under the @notlocal guard with
	# everything else: the only machine that has to reach it is the one you are
	# looking at. Nothing is forwarded at the router and no DNS record is added -
	# the wildcard already resolves this name to 10.0.0.4 and the wildcard cert
	# already covers it.
	#
	# TWO ENTRIES IN Access-Control-Allow-Headers ARE LOAD-BEARING AND NEITHER IS
	# OBVIOUS. Both were learned the hard way; do not tidy either of them away.
	#
	# `Access-Control-Allow-Origin` is a RESPONSE header and has no business
	# being sent by a client - but the map's XHR sets it on the request anyway.
	# So the browser asks for it by name in the preflight, and a preflight that
	# does not permit it fails outright with:
	#
	#   Request header field access-control-allow-origin is not allowed by
	#   Access-Control-Allow-Headers in preflight response
	#
	# Upstream's nginx sample allows exactly this one header and never says why,
	# which reads like cargo cult right up until you delete it. This config did
	# delete it, on 2026-08-29, and that is the whole story of why the map
	# refused to load a save that curl could fetch perfectly.
	#
	# `If-Modified-Since` is what drives the map's auto-refresh, and it is not a
	# CORS-safelisted request header either. Without it the map loads the save
	# once and then never moves again.
	#
	# If the map ever adds another header and this breaks the same way, the
	# blunt fix is to echo the request back:
	#
	#   Access-Control-Allow-Headers {http.request.header.Access-Control-Request-Headers}
	#
	# It works - it is just less honest about what the map actually needs.
	#
	# Last-Modified needs no Access-Control-Expose-Headers entry; it is already
	# on the safelist.
	@spaghetti host spaghetti.{env.DOMAIN}
	handle @spaghetti {
		header {
			Access-Control-Allow-Origin "https://satisfactory-calculator.com"
			Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
			Access-Control-Allow-Headers "Access-Control-Allow-Origin, If-Modified-Since, If-None-Match, Range"
			Access-Control-Max-Age "86400"
		}

		# The preflight, answered here rather than at the upstream: caddy's
		# file-server replies 405 to OPTIONS, which fails the preflight and takes
		# the auto-refresh down with it.
		#
		# Nested `handle` blocks rather than a bare `respond`, for the same
		# reason the LAN guard above is a handle: the order is then written down
		# here instead of inferred from Caddy's directive table.
		@preflight method OPTIONS
		handle @preflight {
			respond 204
		}

		handle {
			# No flush_interval, unlike every other block in this file. This is
			# one large finite file rather than a live stream, and buffering is
			# exactly what you want for it.
			reverse_proxy satisfactory-saves:80
		}
	}

	# --- ai.<domain> - Open WebUI -------------------------------------------
	# The chat UI. Accounts, history, uploaded documents, and the model picker.
	#
	# It has its own login and its own user roles, which makes it the only app
	# in this block with real authentication of its own - but it stays in the
	# LAN-only block anyway. What is behind that login is every conversation
	# anyone in the house has had with it and every document they uploaded to
	# search, which is a more personal archive than anything else on this box
	# except the photo library.
	#
	# Signup is left enabled in the compose file so the first account can be
	# created at all; new accounts land in a pending queue until an admin
	# approves them. That queue is doing real work only because this guard is
	# here - it bounds the damage to somebody already on the LAN.
	@openwebui host ai.{env.DOMAIN}
	handle @openwebui {
		reverse_proxy open-webui:8080 {
			# Generated tokens arrive one at a time over a long-lived streaming
			# response. Without this the page sits blank and then prints a whole
			# answer at once - the same buffering symptom as the blocks above,
			# except here it looks like the model is slow rather than like the
			# page is broken.
			flush_interval -1
		}
	}

	# --- llm.<domain> - the Ollama API, WITH NO AUTHENTICATION --------------
	# Read that heading again before adding anything to this block.
	#
	# Ollama ships no authentication and has no setting to add any. Everything
	# the API can do, it will do for whoever asks: generate, but also pull a
	# model, and DELETE one. This guard is not a defence-in-depth layer here, it
	# is the entire access control, which puts this hostname in the same class
	# as Frigate's port 5000 - the difference being that here there is no
	# authenticated port to point at instead.
	#
	# It exists because the API is the useful half for everything that is not a
	# browser: an editor plugin, a script, a desktop client. Home Assistant is
	# NOT one of those - it is a container, and the @notlocal guard above
	# excludes Docker's own range on purpose, so HA reaches ollama:11434 over
	# the proxy network and never through this name.
	#
	# What is actually at risk is bounded and worth saying plainly: the models
	# are re-downloadable files, and conversations sent straight to the API are
	# not stored. The realistic worst case from the LAN is somebody deleting
	# weights you can pull again, or keeping the GPU busy - which Frigate would
	# notice before you did.
	#
	# If this ever needs to be more than that, the answer is a basicauth
	# directive here rather than anything upstream, and it will break every
	# client that does not let you set a header.
	@ollama host llm.{env.DOMAIN}
	handle @ollama {
		reverse_proxy ollama:11434 {
			# Same reason as ai.<domain> above: generation is a token stream.
			# A client that waits for the whole response still works without
			# this; a client that streams shows nothing until the end.
			flush_interval -1
		}
	}

	# --- template: copy this block for each new app ------------------------
	# @myapp host myapp.{env.DOMAIN}
	# handle @myapp {
	# 	reverse_proxy myapp_container:PORT
	# }

	# Anything not matched gets nothing, rather than an error page that
	# advertises a proxy is sitting here.
	handle {
		abort
	}
}
