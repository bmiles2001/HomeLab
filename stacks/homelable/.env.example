# This is documentation, not a file to copy to .env.
#
# These are the keys Infisical must hold under /homelable for this stack to
# deploy. scripts/deploy.sh injects them as environment variables; compose
# reads them from there. No .env file belongs here - deploy.sh refuses to run
# if it finds one.
#
# Check what Infisical currently has:
#   infisical secrets --env=prod --path=/homelable

# Signs session cookies. Any 32 bytes of randomness.
#   openssl rand -hex 32
# Rotating it logs everyone out and costs nothing else.
SECRET_KEY=

# Local login. The image defaults to admin/admin and starts happily with it,
# which is why both of these are in deploy.sh's required_vars table - an empty
# value here is not a startup failure, it is a default credential sitting in
# front of a map of the house.
AUTH_USERNAME=admin

# bcrypt hash of the password, NOT the password.
#
#   docker run --rm ghcr.io/pouzor/homelable-backend:3.2.0 \
#     python -c 'import bcrypt; print(bcrypt.hashpw(b"yourpassword", bcrypt.gensalt()).decode())'
#
# Paste the result into Infisical verbatim. No quotes, no `$$` escaping - both
# of those pieces of advice are about writing a hash into a .env or a compose
# file, and neither applies to a value stored in Infisical and injected as an
# environment variable. Compose substitutes it once and does not re-scan it.
AUTH_PASSWORD_HASH=

# Duplicated from /caddy. Used to build CORS_ORIGINS as https://lab.<domain>.
# deploy.sh reads one Infisical path per stack, so shared values are copied
# rather than referenced - the same duplication /beszel and /ddns have.
DOMAIN=brent-miles.com

# --- optional, all have defaults in compose.yml -----------------------------

# JSON array of CIDRs the scanner sweeps. Defaults to ["10.0.0.0/24"].
# Also editable in the UI under Scan Network, which is where it will actually
# get changed - this only sets the value a fresh database starts with.
# SCANNER_RANGES=["10.0.0.0/24"]

# Seconds between status re-checks of known nodes. Defaults to 60.
# STATUS_CHECKER_INTERVAL=60

# Image tag for both containers. Defaults to 3.2.0. They are built and
# published together and are not intended to be mixed.
# HOMELABLE_VERSION=3.2.0

# Bind mount host path for the SQLite database and uploaded floor plans.
# Defaults to /srv/homelable/data.
# HOMELABLE_DATA=/srv/homelable/data

# --- deliberately absent ----------------------------------------------------
#
# MCP_API_KEY / MCP_SERVICE_KEY  - the mcp service is not deployed.
# LIVEVIEW_KEY                   - a read-only canvas at /view?key=..., which
#                                  is an authentication bypass by design. If it
#                                  is ever wanted, it needs its own decision
#                                  entry, not a quiet key in Infisical.
# HOMEPAGE_API_KEY               - nothing here runs gethomepage.
# PROXMOX_*                      - no Proxmox on this network.
# ZIGBEE_MQTT_* / ZWAVE_MQTT_*   - mosquitto is on its own network, not
#                                  `proxy`, and this stack is not on it. Wiring
#                                  Zigbee auto-sync means adding homelable to
#                                  the mqtt network first - see
#                                  docs/decisions.md#mqtt-gets-its-own-network-not-proxy.
