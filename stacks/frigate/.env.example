# This is documentation, not a file to copy to .env.
#
# These are the keys Infisical must hold under /frigate for this stack to
# deploy. scripts/deploy.sh injects them as environment variables; compose
# interpolates them. No .env file should ever exist in this directory.
#
# Check what Infisical currently has:
#   infisical secrets --env=prod --path=/frigate

# --- required, no default -------------------------------------------------
# The password on the camera's own RTSP account. Referenced inside config.yml
# as {FRIGATE_RTSP_PASSWORD}, so the camera URLs can live in git safely.
#
# Give the cameras a dedicated non-admin account rather than reusing admin, and
# use the same password across all of them - Frigate substitutes one variable.
# If your cameras need different passwords, add FRIGATE_RTSP_PASSWORD_<NAME>
# keys and reference them individually.
FRIGATE_RTSP_PASSWORD=

# Broker credentials. These must match the values under /mosquitto exactly -
# they are the same account, stored twice because deploy.sh scopes each stack
# to its own Infisical path. If they drift, Frigate logs "Unable to connect to
# MQTT server" every few seconds and Home Assistant simply shows no cameras.
FRIGATE_MQTT_USER=
FRIGATE_MQTT_PASSWORD=

# --- optional, sensible defaults in compose.yml ---------------------------
# Note the image tag is built as ${FRIGATE_VERSION}-tensorrt, so set the plain
# version number here. Setting it to "0.17.2-tensorrt" produces a tag ending
# -tensorrt-tensorrt and a confusing manifest-unknown error.
FRIGATE_VERSION=0.17.2
TZ=America/Chicago

# Snapshots today, recordings when a dedicated disk exists. Point this at the
# new drive's mount point on the day it goes in - it is the only change needed
# on this side. See docs/frigate.md#the-thing-that-will-actually-bite-you-storage
FRIGATE_MEDIA=/srv/frigate/media

# Where the detector model lives. Frigate does not start without a model in
# here - build it once per docs/frigate.md#step-1-build-the-detector-model.
FRIGATE_MODELS=/srv/frigate/models
