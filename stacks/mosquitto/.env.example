# This is documentation, not a file to copy to .env.
#
# Keys Infisical must hold under /mosquitto. scripts/deploy.sh injects them;
# compose interpolates them. No .env file should ever exist here.
#
#   infisical secrets --env=prod --path=/mosquitto

# --- required, no default -------------------------------------------------
# One account, shared by Frigate and Home Assistant. MQTT's permission model
# is flat - a per-client ACL would be theatre when both clients need to read
# and write the same frigate/# topics anyway.
#
# The same pair must also exist under /frigate as FRIGATE_MQTT_USER and
# FRIGATE_MQTT_PASSWORD, and be entered into Home Assistant's MQTT integration
# by hand at setup. Three copies of one credential is the cost of deploy.sh
# scoping each stack to its own Infisical path; rotating it means changing all
# three. See docs/home-assistant.md#rotating-the-mqtt-password.
MQTT_USER=frigate
MQTT_PASSWORD=

# --- optional, sensible defaults in compose.yml ---------------------------
MOSQUITTO_VERSION=2
TZ=America/Chicago
