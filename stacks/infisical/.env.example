# Infisical is the ONE stack that uses a real .env file, because it cannot
# fetch its own secrets from itself. Copy this to .env in the same directory,
# fill it in, and keep a copy in your password manager.
#
#   cp .env.example .env
#
# .env is gitignored. If it ever appears in `git status`, stop and fix the
# gitignore before committing.

# 16-byte hex string. THIS IS THE MASTER KEY.
# Rotate it and every secret already stored becomes unreadable.
#   openssl rand -hex 16
ENCRYPTION_KEY=

# Signs session tokens. Rotating this just logs everyone out.
#   openssl rand -base64 32
AUTH_SECRET=

# Postgres for Infisical itself. Nothing else uses this database.
#   openssl rand -base64 32 | tr -d '/+='
DB_USER=infisical
DB_PASSWORD=
DB_NAME=infisical

# Must match the URL you actually open in a browser, or invite links and
# OAuth callbacks will point at the wrong place.
SITE_URL=https://secrets.brent-miles.com

# Optional - pinned in compose.yml if unset.
INFISICAL_VERSION=latest-postgres
