# This is documentation, not a file to copy to .env.
#
# Keys Infisical must hold under /homeassistant. scripts/deploy.sh injects
# them; compose interpolates them. No .env file should ever exist here.
#
#   infisical secrets --env=prod --path=/homeassistant
#
# Unusually for this repo, this stack has no secrets at all. HA keeps its own
# credentials in .storage/ inside the data directory, entered through the UI
# on first run - including the MQTT password. The path still needs to exist in
# Infisical, empty, or deploy.sh has nothing to read.

# --- optional, sensible defaults in compose.yml ---------------------------
# `stable` rather than a pinned number. HA ships a breaking-change release
# monthly and pinning here would mean editing this file twelve times a year to
# stand still. The tradeoff is that `docker compose pull` can move you across
# a breaking change without warning - read the release notes before pulling,
# and note that HA does not support downgrades once its database has migrated.
HA_VERSION=stable

TZ=America/Chicago

HA_CONFIG=/srv/homeassistant/config
