[Unit]
Description=Keep the Satisfactory latest-save symlink current

[Timer]
# Every minute, against a server that autosaves every five. The map is
# something you open on purpose, so worst-case staleness of about a minute is
# invisible - and polling a directory with a handful of files costs nothing.
#
# The event-driven alternative is a systemd .path unit on PathChanged, which
# fires on close-after-write and would be instant. It is not used because a
# .path unit watches ONE directory and does not recurse, so it has to be
# pointed at the exact session directory the server happens to have created.
# That is a hostname-in-a-config-file problem: it works until the day a new
# session appears and then silently stops. See
# docs/satisfactory.md#viewing-the-save-on-the-interactive-map.
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=30s

[Install]
WantedBy=timers.target
